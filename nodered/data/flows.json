  {
    "id": "fn_parse_kpis",
    "type": "function",
    "z": "flow_s2_id",
    "name": "Extract Live KPIs",
    "func": "// Extrai os campos do live_summary emitido pelo Processor\nif (!msg.payload) return null;\nvar p = msg.payload;\nreturn [\n    { payload: p.active_trips || 0, topic: \"active_trips\" },\n    { payload: p.total_bikes_avail || 0, topic: \"total_bikes_avail\" },\n    { payload: p.total_ebikes_avail || 0, topic: \"total_ebikes_avail\" },\n    { payload: Number((p.stage2_energy_kwh || 0).toFixed(2)), topic: \"stage2_energy_kwh\" },\n    { payload: Number((p.stage2_avg_duration_min || 0).toFixed(1)), topic: \"stage2_avg_duration_min\" }\n];",
    "outputs": 5,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 180,
    "wires": [
      [
        "gauge_active_trips"
      ],
      [
        "gauge_bikes_avail"
      ],
      [
        "gauge_ebikes_avail"
      ],
      [
        "gauge_energy"
      ],
      [
        "gauge_duration"
      ]
    ]
  },
