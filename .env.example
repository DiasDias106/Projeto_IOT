# Created by scripts/setup.sh (or: cp .env.example .env and fill it in).
# .env never goes to git.

# ---------- Group ----------
GROUP_ID=fc15
TOPIC_PREFIX=idc/fc15

# ---------- MQTT (Mosquitto, TLS on port 1883, no anonymous access) ----------
MQTT_HOST=mosquitto
MQTT_PORT=1883
# One user per client (ACL per client)
MQTT_CLIENT1_USER=client1
MQTT_CLIENT1_PASSWORD=
MQTT_PROCESSOR_USER=processor
MQTT_PROCESSOR_PASSWORD=
MQTT_NODERED_USER=nodered
MQTT_NODERED_PASSWORD=

# ---------- MySQL (TLS connections) ----------
DB_HOST=db
DB_PORT=3306
DB_NAME=bikesharing
DB_ROOT_PASSWORD=
# Only the Processor writes the data; ML writes only station_clusters; Node-RED only reads
DB_PROCESSOR_USER=processor
DB_PROCESSOR_PASSWORD=
DB_ML_USER=ml
DB_ML_PASSWORD=
DB_NODERED_USER=nodered
DB_NODERED_PASSWORD=

# ---------- ML (Flask, HTTPS) ----------
ML_URL=https://ml:5000
RETRAIN_EVERY_HOURS=6

# ---------- Processor ----------
# Interval (wall clock) of idc/fc15/internal/live_summary
SUMMARY_INTERVAL_S=2
# T2 worker threads, Writer batch size and maximum wait before a batch is written
WORKER_THREADS=2
WRITER_BATCH_SIZE=500
WRITER_FLUSH_S=0.5

# ---------- Node-RED (HTTPS on port 1880, editor login) ----------
NODERED_ADMIN_USER=admin
# bcrypt hash of the editor password. Generate it with:
#   docker run --rm -it --entrypoint npx nodered/node-red:4.0.9 node-red admin hash-pw
# Use single quotes, because the hash contains '$':  NODERED_ADMIN_PASSWORD_HASH='$2b$08$...'
NODERED_ADMIN_PASSWORD_HASH=
# Long random text, used to encrypt the flow credentials
NODERED_CREDENTIAL_SECRET=

# ---------- Client 1 (publisher, runs on the host) ----------
CLIENT1_MQTT_HOST=localhost
REPLAY_SPEED=60
