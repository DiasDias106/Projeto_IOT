# Copiar para .env e preencher:  cp .env.example .env
# O .env nunca vai para o git.

# ---------- Grupo ----------
GROUP_ID=fc15
TOPIC_PREFIX=idc/fc15

# ---------- MQTT (Mosquitto, TLS na porta 1883, sem acesso anónimo) ----------
MQTT_HOST=mosquitto
MQTT_PORT=1883
# Um utilizador por cliente (ACL por cliente)
MQTT_CLIENT1_USER=client1
MQTT_CLIENT1_PASSWORD=
MQTT_PROCESSOR_USER=processor
MQTT_PROCESSOR_PASSWORD=
MQTT_NODERED_USER=nodered
MQTT_NODERED_PASSWORD=

# ---------- MySQL (ligações com TLS) ----------
DB_HOST=db
DB_PORT=3306
DB_NAME=bikesharing
DB_ROOT_PASSWORD=
# Só o Processor escreve os dados; o ML escreve apenas station_clusters; o Node-RED só lê
DB_PROCESSOR_USER=processor
DB_PROCESSOR_PASSWORD=
DB_ML_USER=ml
DB_ML_PASSWORD=
DB_NODERED_USER=nodered
DB_NODERED_PASSWORD=

# ---------- ML (Flask, HTTPS) ----------
ML_URL=https://ml:5000
RETRAIN_EVERY_HOURS=6

# ---------- Processor ----------
# Intervalo (relógio real) do idc/fc15/internal/live_summary
SUMMARY_INTERVAL_S=2

# ---------- Node-RED (HTTPS na porta 1880, login no editor) ----------
NODERED_ADMIN_USER=admin
# Hash bcrypt da password do editor. Gerar com:
#   docker run --rm -it --entrypoint npx nodered/node-red:4.0.9 node-red admin hash-pw
# Pôr entre plicas, porque o hash tem '$':  NODERED_ADMIN_PASSWORD_HASH='$2b$08$...'
NODERED_ADMIN_PASSWORD_HASH=
# Texto aleatório longo, usado para cifrar as credenciais dos flows
NODERED_CREDENTIAL_SECRET=

# ---------- Client 1 (publisher, corre no host) ----------
CLIENT1_MQTT_HOST=localhost
REPLAY_SPEED=60
