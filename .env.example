# Copiar para .env e preencher:  cp .env.example .env

# Grupo (tópicos MQTT: idc/fcXX/...)
GROUP_ID=fcXX

# MQTT (Mosquitto com TLS)
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_USER=
MQTT_PASSWORD=
MQTT_CA_CERT=/certs/ca.crt

# Base de dados
DB_HOST=db
DB_PORT=3306
DB_NAME=bikesharing
DB_USER=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Publisher (Client 1)
REPLAY_SPEED=60
