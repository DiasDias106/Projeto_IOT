# ACL per client (group 15). See design-plan.md, section 2.

# Client 1: stations (stage 2 publisher)
user client1
topic write idc/fc15/status/+
topic write idc/fc15/trips/started
topic write idc/fc15/trips/ended

# Processor: receives the station data and publishes the internal topics
user processor
topic read idc/fc15/status/+
topic read idc/fc15/trips/started
topic read idc/fc15/trips/ended
topic write idc/fc15/internal/#
# Used by the broker container healthcheck
topic read $SYS/broker/uptime

# Node-RED: reads the internal topics only
user nodered
topic read idc/fc15/internal/#
